# LeadEngine Environment Configuration
# Copy this file to .env and fill in your values

# Database (SQLite - default path)
DATABASE_URL=sqlite+aiosqlite:///./leadengine.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Rate Limiting
REQUESTS_PER_SECOND=2
CONCURRENT_ANALYSES=5

# Optional API Keys (enhance functionality when provided)
# SERPAPI_KEY=            # Google search auto-discovery
# HUNTER_IO_KEY=         # Email finding / verification
# META_AD_LIBRARY_TOKEN= # Meta Ad Library API
# OPENAI_API_KEY=        # LLM-powered pitch generation

# Scraper Settings
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
REQUEST_TIMEOUT=30
